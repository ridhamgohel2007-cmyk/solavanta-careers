# ==============================================================================
# Solavanta Careers — Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS FOR DEVELOPER / CLIENT:
# 1. Duplicate this file and rename the copy to '.env' (do NOT commit .env to Git).
# 2. Fill in the values from your Supabase Project Settings -> API.
# 3. In Vercel, add these same variables in Project Settings -> Environment Variables.
# ==============================================================================

# --- Supabase Public Configuration (Safe for Frontend Use) ---
# Your unique Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous Public API Key (safe to use in browser JavaScript with RLS enabled)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-here

# --- Supabase Private Configuration (Backend / Edge Functions ONLY) ---
# NEVER expose this key in public frontend HTML or client JavaScript!
# The Service Role Key bypasses Row-Level Security and is for administrative tasks only.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# --- Application Environment ---
ENVIRONMENT=development
SITE_URL=http://localhost:8080
PRODUCTION_URL=https://solavantacareers.com

# --- Optional External Services (For Phase 9 Notifications) ---
# NOTIFICATION_EMAIL=admissions@solavantacareers.com
# RESEND_API_KEY=re_your_resend_api_key_here
